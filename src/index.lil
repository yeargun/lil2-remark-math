// lil2-remark-math: markdown with math (`$…$`, `$$` fences) to mdast and hast columns. Higher layers compile
// `math/math.lil` in instead.

import { SyntaxExtension } from "./micromark/parse.lil";
import { parseTree } from "./mdast/parse.lil";
import { Tree } from "./mdast/tree.lil";
import { FromMarkdown } from "./mdast/from-markdown.lil";
import { Hast, keywordNames, propNames, tagNames } from "./hast/hast.lil";
import { ToHast, toHast, toHastTree } from "./hast/to-hast.lil";
import { mathHast, mathMdast, mathSyntax } from "./math/math.lil";

Tree mathTree(string value, bool singleDollarTextMath) {
  SyntaxExtension[] extensions = [mathSyntax(singleDollarTextMath)];
  (func(FromMarkdown)->void)[] installers = [mathMdast];
  return parseTree(value, extensions, installers);
}

// The mdast columns, as lil2-mdast-util-from-markdown's `fromMarkdown` returns them.
export JsValue fromMarkdown(string value, bool singleDollarTextMath) {
  Tree t = mathTree(value, singleDollarTextMath);
  return [t.kind, t.flags, t.parent, t.firstChild, t.nextSibling, t.sOffset, t.eOffset, t.num, t.s1, t.s2, t.s3, t.identifier, t.label, t.lineStarts, t.identifiers, t.aux];
}

// The hast columns, as lil2-mdast-util-to-hast's `markdownToHast` returns them.
export JsValue markdownToHast(string value, bool allowDangerousHtml) {
  ToHast state = toHastTree(mathTree(value, true), allowDangerousHtml);
  mathHast(state);
  int root = toHast(state);
  Hast h = state.hast;
  return [root, h.kind, h.parent, h.firstChild, h.nextSibling, h.tag, h.value, h.sOffset, h.eOffset, h.flags, h.meta, h.propHead, h.pProp, h.pKind, h.pStr, h.pNum, h.pNext, h.lineStarts, tagNames];
}

export { propNames, keywordNames };
